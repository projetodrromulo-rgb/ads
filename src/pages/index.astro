---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero/Hero.astro";
---

<Layout
  title="Dr. Rômulo Oliveira | Cirurgião Especialista em coluna com atendimento no Hospital Biocor no Vila Da Serra/Nova Lima"
  description="Dr. Rômulo Oliveira, Médico Ortopedista Especialista em Coluna. Atendimento no Hospital Biocor - Rede D'Or em Nova Lima com foco em cirurgias minimamente invasivas."
>
  <Hero />

  <!-- INTRODUCTION & VALUE PROP -->
  <section class="py-24 bg-white text-slate-900">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2
          class="font-playfair text-4xl md:text-5xl font-bold text-slate-900 mb-8"
        >
          Precisando de um médico especialista em coluna em Nova Lima?
        </h2>
        <a
          href="#whatsapp"
          class="inline-flex items-center gap-3 bg-green-700 hover:bg-green-800 text-white font-semibold px-8 py-4 rounded-full transition-all duration-300 shadow-lg shadow-green-700/30"
        >
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"
            ><path
              d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"
            ></path><path
              d="M12 0C5.373 0 0 5.373 0 12c0 2.127.558 4.122 1.532 5.852L.057 23.996l6.304-1.654A11.944 11.944 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.797 9.797 0 01-5.003-1.374l-.36-.214-3.722.976.995-3.63-.235-.374A9.78 9.78 0 012.182 12C2.182 6.57 6.57 2.182 12 2.182S21.818 6.57 21.818 12 17.43 21.818 12 21.818z"
            ></path></svg
          >
          Chamar no WhatsApp
        </a>
      </div>

      <div class="grid md:grid-cols-3 gap-8 mt-16">
        {
          [
            {
              title: "Atendimento Especializado",
              desc: "Foco exclusivo em patologias da coluna vertebral, garantindo diagnósticos precisos e tratamentos eficazes.",
            },
            {
              title: "Tecnologia de Ponta",
              desc: "Utilização das mais modernas técnicas mundiais em cirurgias minimamente invasivas e endoscopia de coluna.",
            },
            {
              title: "Recuperação Rápida",
              desc: "Procedimentos focados em preservar a musculatura, resultando em menos dor pós-operatória e alta precoce.",
            },
          ].map((item) => (
            <div class="bg-slate-50 rounded-2xl p-8 border border-slate-100 hover:shadow-xl transition-shadow duration-300">
              <div class="w-12 h-12 bg-blue-100 text-blue-600 rounded-xl flex items-center justify-center mb-6">
                <svg
                  class="w-6 h-6"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                  />
                </svg>
              </div>
              <h3 class="font-playfair text-2xl font-bold mb-4">
                {item.title}
              </h3>
              <p class="text-slate-600 leading-relaxed">{item.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- OFFICE LOCATION -->
  <section id="locais" class="py-24 bg-slate-50">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-16">
        <h2 class="font-playfair text-4xl md:text-5xl font-bold text-slate-900">
          Locais de Atendimento em Nova Lima
        </h2>
      </div>

      <div
        class="bg-white rounded-3xl overflow-hidden shadow-xl border border-slate-100 grid md:grid-cols-2"
      >
        <div class="p-10 lg:p-16 flex flex-col justify-center">
          <div
            class="inline-flex items-center gap-2 bg-blue-50 text-blue-600 px-4 py-2 rounded-lg font-medium text-sm mb-6 w-fit"
          >
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m3-4h1m-1 4h1m-5 8h8"
              ></path></svg
            >
            Hospital Biocor
          </div>

          <h3 class="font-playfair text-3xl font-bold text-slate-900 mb-4">
            Biocor - Instituto e Hospital<br /><span
              class="text-xl text-slate-500 font-medium"
              >Rede D'Or São Luiz</span
            >
          </h3>

          <p class="text-slate-600 flex items-start gap-3 mb-8">
            <svg
              class="w-6 h-6 text-slate-400 shrink-0 mt-0.5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
              ></path><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg
            >
            <span
              >Rua da Paisagem, 280 - Vila da Serra<br />Nova Lima - MG,
              34000-000</span
            >
          </p>

          <div class="flex flex-wrap gap-4">
            <a
              href="https://maps.google.com"
              target="_blank"
              class="bg-[#0B1423] hover:bg-blue-900 text-white font-medium px-6 py-3 rounded-lg transition-colors flex items-center gap-2 text-sm uppercase tracking-wide"
            >
              <svg
                class="w-4 h-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"
                ></path></svg
              >
              Como Chegar
            </a>
            <button
              class="bg-blue-50 hover:bg-blue-100 text-blue-700 font-medium px-6 py-3 rounded-lg transition-colors text-sm uppercase tracking-wide"
            >
              Convênios Aceitos
            </button>
          </div>
        </div>
        <div class="h-64 md:h-auto bg-slate-200 relative">
          <!-- Placeholder for map -->
          <div
            class="absolute inset-0 bg-slate-300 flex items-center justify-center"
          >
            <span class="text-slate-700 font-medium">[ Google Maps Embed ]</span
            >
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- VISUAL TRANSITION -->
  <section
    class="relative h-64 md:h-96 overflow-hidden flex items-center justify-center"
  >
    <div class="absolute inset-0 bg-[#070F19]">
      <img
        src="https://images.unsplash.com/photo-1579684385127-1ef15d508118?q=80&w=2000&auto=format&fit=crop"
        alt="Coluna Vertebral"
        class="w-full h-full object-cover opacity-20"
      />
    </div>
    <h2
      class="relative z-10 font-playfair text-4xl md:text-6xl font-bold text-white tracking-wider"
    >
      TECNOLOGIA & PRECISÃO
    </h2>
  </section>

  <!-- TESTIMONIALS -->
  <section id="depoimentos" class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-16">
        <h2
          class="font-playfair text-4xl md:text-5xl font-bold text-slate-900 mb-4"
        >
          O que dizem nossos Pacientes
        </h2>
        <div
          class="flex items-center justify-center gap-2 text-lg font-medium text-slate-700"
        >
          <span class="text-yellow-400">★★★★★</span> 5.0 no Google Avaliações
        </div>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        {
          [
            {
              name: "Christopher S. T.",
              text: "Excelente profissional! Me passou muita segurança desde a primeira consulta. A cirurgia foi um sucesso e minha recuperação super rápida. Recomendo de olhos fechados.",
            },
            {
              name: "Maria Helena",
              text: "Depois de anos sentindo dores na lombar, encontrei o Dr. Rômulo. O atendimento no Biocor foi impecável e a técnica minimamente invasiva mudou minha vida.",
            },
            {
              name: "João Paulo",
              text: "Profissionalismo e competência resumem. Explica tudo com muita clareza, tirando todas as dúvidas. A estrutura do hospital também é excelente.",
            },
          ].map((review) => (
            <div class="bg-slate-50 p-8 rounded-2xl border border-slate-100 relative">
              <div class="flex text-yellow-400 mb-4">★★★★★</div>
              <p class="text-slate-600 mb-6 italic">"{review.text}"</p>
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-blue-100 text-blue-700 font-bold flex items-center justify-center rounded-full">
                  {review.name.charAt(0)}
                </div>
                <span class="font-medium text-slate-900">{review.name}</span>
              </div>
              <div class="absolute top-8 right-8 opacity-10 text-6xl font-serif">
                "
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-24 bg-slate-50">
    <div class="max-w-4xl mx-auto px-6">
      <div class="text-center mb-12">
        <h2 class="font-playfair text-4xl font-bold text-slate-900">
          Perguntas Frequentes sobre Atendimento em Nova Lima
        </h2>
      </div>

      <div class="space-y-4 mb-12">
        {
          [
            {
              q: "Quais convênios são aceitos no Hospital Biocor?",
              a: "Atendemos os principais convênios do mercado. Entre em contato com nossa equipe via WhatsApp para verificar a cobertura exata do seu plano para consultas e cirurgias.",
            },
            {
              q: "Como agendar uma consulta?",
              a: 'Você pode agendar sua consulta diretamente pelo nosso WhatsApp, ligando para nossa central de atendimento ou clicando no botão "Agendamento On-line" no topo da página.',
            },
            {
              q: "O que é cirurgia minimamente invasiva?",
              a: "É uma técnica avançada que utiliza pequenas incisões, causando menos danos aos tecidos musculares. Isso resulta em menos dor no pós-operatório, menor tempo de internação e recuperação mais rápida.",
            },
          ].map((faq) => (
            <details class="group bg-white rounded-xl border border-slate-200 [&_summary::-webkit-details-marker]:hidden">
              <summary class="flex cursor-pointer items-center justify-between gap-1.5 p-6 text-slate-900 font-medium">
                <h3 class="text-lg">{faq.q}</h3>
                <span class="shrink-0 rounded-full bg-slate-100 p-1.5 text-slate-900 sm:p-3 group-open:bg-blue-50 group-open:text-blue-600">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-5 h-5 transition duration-300 group-open:-rotate-45"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z"
                      clip-rule="evenodd"
                    />
                  </svg>
                </span>
              </summary>
              <p class="px-6 pb-6 text-slate-600 leading-relaxed">{faq.a}</p>
            </details>
          ))
        }
      </div>

      <div class="bg-blue-600 rounded-2xl p-8 md:p-12 text-center text-white">
        <h3 class="text-2xl font-bold mb-4">
          Ainda tem alguma dúvida específica?
        </h3>
        <p class="text-blue-50 mb-8 max-w-xl mx-auto">
          Nossa equipe está pronta para ajudar você com informações sobre
          agendamentos, convênios e tratamentos.
        </p>
        <a
          href="#whatsapp"
          class="inline-flex items-center gap-3 bg-white text-blue-600 hover:bg-blue-50 font-semibold px-8 py-4 rounded-full transition-colors"
        >
          Falar com a Equipe no WhatsApp
        </a>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="bg-[#0B1423] pt-20 pb-10 border-t border-white/10">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">
        <div class="lg:col-span-2">
          <div class="flex items-center gap-3 mb-6">
            <div
              class="w-8 h-8 rounded-full bg-blue-600 text-white font-bold flex items-center justify-center"
            >
              RO
            </div>
            <span class="font-bold text-white text-xl tracking-tight"
              >DR. RÔMULO OLIVEIRA</span
            >
          </div>
          <p class="text-slate-400 max-w-sm mb-6 leading-relaxed">
            Ortopedista e Cirurgião de Coluna dedicado a devolver a qualidade de
            vida aos seus pacientes através das técnicas mais modernas da
            medicina.
          </p>
          <div class="space-y-2 text-sm font-medium text-slate-300">
            <p>CRM/MG 73889</p>
            <p>RQE 59057 — Ortopedia e Traumatologia</p>
            <p>TEOT 19406</p>
          </div>
        </div>

        <div>
          <h4
            class="text-white font-semibold mb-6 uppercase tracking-wider text-sm"
          >
            Links Úteis
          </h4>
          <ul class="space-y-4 text-slate-400">
            <li>
              <a href="#" class="hover:text-blue-400 transition-colors"
                >Início</a
              >
            </li>
            <li>
              <a href="#sobre" class="hover:text-blue-400 transition-colors"
                >Sobre o Dr. Rômulo</a
              >
            </li>
            <li>
              <a
                href="#especialidades"
                class="hover:text-blue-400 transition-colors">Especialidades</a
              >
            </li>
            <li>
              <a href="#blog" class="hover:text-blue-400 transition-colors"
                >Blog e Artigos</a
              >
            </li>
          </ul>
        </div>

        <div>
          <h4
            class="text-white font-semibold mb-6 uppercase tracking-wider text-sm"
          >
            Nossas Unidades
          </h4>
          <ul class="space-y-4 text-slate-400">
            <li>
              <a href="/nova-lima" class="text-blue-400 font-medium"
                >Nova Lima (Biocor)</a
              >
            </li>
            <li>
              <a
                href="/belo-horizonte"
                class="hover:text-blue-400 transition-colors">Belo Horizonte</a
              >
            </li>
            <li>
              <a href="/betim" class="hover:text-blue-400 transition-colors"
                >Betim</a
              >
            </li>
            <li>
              <a href="/contagem" class="hover:text-blue-400 transition-colors"
                >Contagem</a
              >
            </li>
          </ul>
        </div>
      </div>

      <div
        class="pt-8 border-t border-white/10 flex flex-col md:flex-row items-center justify-between gap-4 text-sm text-slate-400"
      >
        <p>
          © {new Date().getFullYear()} Dr. Rômulo Oliveira. Todos os direitos reservados.
        </p>
        <div class="flex items-center gap-2">
          <span>Desenvolvido com</span>
          <svg
            class="w-4 h-4 text-red-500"
            fill="currentColor"
            viewBox="0 0 24 24"
            ><path
              d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
            ></path></svg
          >
        </div>
      </div>
    </div>
  </footer>
</Layout>
