---
import { heroData } from "./data";
---

<!-- HERO SECTION -->
<section
  class="relative min-h-screen flex flex-col justify-center pb-0 overflow-hidden bg-[#112A3D]"
>
  <!-- Tera Style Animated Grid Background -->
  <div class="absolute inset-0 z-0 bg-[#112A3D] overflow-hidden">
    <!-- Doctor Portrait Image -->
    <img
      src={heroData.doctorImage}
      alt={heroData.doctorName}
      class="absolute bottom-0 right-0 md:right-[5%] lg:right-[8%] h-[55%] md:h-[88%] w-auto object-contain z-10 opacity-30 md:opacity-100 transition-all duration-300 pointer-events-none"
    />
    <!-- Gradients to blend background and protect text -->
    <div
      class="absolute inset-0 bg-gradient-to-r from-[#112A3D] via-[#112A3D]/90 to-transparent z-0"
    >
    </div>
    <div
      class="absolute inset-0 bg-gradient-to-t from-[#112A3D] via-transparent to-[#112A3D]/80 z-0"
    >
    </div>
    <!-- Central Glow -->
    <div
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-blue-400/10 rounded-full blur-[120px] pointer-events-none"
    >
    </div>

    <!-- Radial Masked Grid -->
    <div class="absolute inset-0 bg-grid radial-mask opacity-40"></div>

    <!-- ECG / EKG Animated Lines -->
    <!-- Line 1: bottom area -->
    <svg
      class="absolute w-full pointer-events-none"
      style="bottom: 18%; left: 0; height: 80px;"
      viewBox="0 0 1440 80"
      preserveAspectRatio="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <polyline
        class="ekg-line"
        fill="none"
        stroke="rgba(56,189,248,0.85)"
        stroke-width="1.8"
        points="0,40 60,40 75,40 90,10 100,70 112,5 122,60 135,40 200,40 260,40 275,40 290,10 300,70 312,5 322,60 335,40 400,40 460,40 475,40 490,10 500,70 512,5 522,60 535,40 600,40 660,40 675,40 690,10 700,70 712,5 722,60 735,40 800,40 860,40 875,40 890,10 900,70 912,5 922,60 935,40 1000,40 1060,40 1075,40 1090,10 1100,70 1112,5 1122,60 1135,40 1200,40 1260,40 1275,40 1290,10 1300,70 1312,5 1322,60 1335,40 1440,40"
      ></polyline>
    </svg>
    <!-- Line 2: middle area, offset timing -->
    <svg
      class="absolute w-full pointer-events-none"
      style="top: 28%; left: 0; height: 60px;"
      viewBox="0 0 1440 60"
      preserveAspectRatio="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <polyline
        class="ekg-line ekg-line-2"
        fill="none"
        stroke="rgba(56,189,248,0.45)"
        stroke-width="1.2"
        points="0,30 60,30 75,30 90,8 100,52 112,3 122,46 135,30 200,30 260,30 275,30 290,8 300,52 312,3 322,46 335,30 400,30 460,30 475,30 490,8 500,52 512,3 522,46 535,30 600,30 660,30 675,30 690,8 700,52 712,3 722,46 735,30 800,30 860,30 875,30 890,8 900,52 912,3 922,46 935,30 1000,30 1060,30 1075,30 1090,8 1100,52 1112,3 1122,46 1135,30 1200,30 1260,30 1275,30 1290,8 1300,52 1312,3 1322,46 1335,30 1440,30"
      ></polyline>
    </svg>
    <!-- Line 3: lower middle area, offset timing -->
    <svg
      class="absolute w-full pointer-events-none"
      style="top: 55%; left: 0; height: 50px;"
      viewBox="0 0 1440 50"
      preserveAspectRatio="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <polyline
        class="ekg-line ekg-line-3"
        fill="none"
        stroke="rgba(56,189,248,0.35)"
        stroke-width="1.0"
        points="0,25 60,25 75,25 90,6 100,44 112,2 122,38 135,25 200,25 260,25 275,25 290,6 300,44 312,2 322,38 335,25 400,25 460,25 475,25 490,6 500,44 512,2 522,38 535,25 600,25 660,25 675,25 690,6 700,44 712,2 722,38 735,25 800,25 860,25 875,25 890,6 900,44 912,2 922,38 935,25 1000,25 1060,25 1075,25 1090,6 1100,44 1112,2 1122,38 1135,25 1200,25 1260,25 1275,25 1290,6 1300,44 1312,2 1322,38 1335,25 1440,25"
      ></polyline>
    </svg>
  </div>

  <!-- Main Content Container -->
  <div
    class="max-w-7xl mx-auto px-6 relative z-20 flex-1 flex flex-col justify-center w-full"
  >
    <div class="flex flex-col justify-center w-full max-w-2xl">
      <!-- Badges Container -->
      <div class="flex flex-wrap items-center gap-3 mb-6">
        {
          heroData.badges.map((badge) => (
            <div
              class="inline-flex flex-row items-center gap-2 border border-white/10 bg-white/5 rounded-full px-4 py-1.5 text-xs font-semibold text-blue-400 backdrop-blur-sm"
            >
              <svg
                class="w-3.5 h-3.5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                />
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                />
              </svg>
              {badge}
            </div>
          ))
        }
      </div>

      <!-- Main Copy -->
      <div class="border-l-2 border-blue-500 pl-4 mb-4 drop-shadow-md">
        <h2 class="text-lg md:text-xl font-medium text-slate-300">
          {heroData.subtitle}
        </h2>
      </div>

      <h1
        class="font-playfair text-6xl md:text-7xl lg:text-[5.5rem] font-bold text-white leading-[1.1] mb-6 drop-shadow-lg"
        set:html={heroData.title}
      />

      <p
        class="text-lg text-slate-300 max-w-xl mb-10 leading-relaxed drop-shadow-md"
      >
        {heroData.description}
      </p>

      <!-- CTAs -->
      <div class="flex flex-wrap gap-4">
        {
          heroData.ctas.map((cta) => {
            if (cta.type === 'whatsapp') {
              return (
                <a
                  href={cta.link}
                  class="group flex items-center gap-3 bg-transparent border border-green-500/50 hover:bg-green-500/10 text-green-400 font-medium px-8 py-3.5 rounded-full transition-all duration-300 bg-black/20 backdrop-blur-sm shadow-xl"
                >
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z" />
                    <path d="M12 0C5.373 0 0 5.373 0 12c0 2.127.558 4.122 1.532 5.852L.057 23.996l6.304-1.654A11.944 11.944 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.797 9.797 0 01-5.003-1.374l-.36-.214-3.722.976.995-3.63-.235-.374A9.78 9.78 0 012.182 12C2.182 6.57 6.57 2.182 12 2.182S21.818 6.57 21.818 12 17.43 21.818 12 21.818z" />
                  </svg>
                  {cta.text}
                </a>
              );
            } else {
              return (
                <a
                  href={cta.link}
                  class="group flex items-center gap-3 bg-transparent border border-blue-500/30 hover:bg-blue-500/10 text-blue-400 font-medium px-8 py-3.5 rounded-full transition-all duration-300 bg-black/20 backdrop-blur-sm shadow-xl"
                >
                  <svg
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                    />
                  </svg>
                  {cta.text}
                </a>
              );
            }
          })
        }
      </div>
    </div>
  </div>

  <!-- Info Sub-bar -->
  <div
    class="relative z-20 mt-auto border-t border-white/5 bg-[#070F19]/80 backdrop-blur-md"
  >
    <div
      class="max-w-7xl mx-auto px-6 py-4 flex flex-col md:flex-row items-center justify-between gap-4 text-xs font-medium text-slate-400"
    >
      {
        heroData.infoItems.map((item, idx) => {
          const isLast = idx === heroData.infoItems.length - 1;
          const ContentTag = item.link ? 'a' : 'div';
          const linkProps = item.link 
            ? { href: item.link, class: "flex items-center gap-2 text-blue-400 hover:text-blue-300" } 
            : { class: "flex items-center gap-2" };
          
          return (
            <>
              <ContentTag {...linkProps}>
                {item.icon === 'shield' && (
                  <svg
                    class="w-4 h-4 text-blue-500"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                    />
                  </svg>
                )}
                {item.icon === 'star' && (
                  <svg
                    class="w-4 h-4 text-blue-500"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"
                    />
                  </svg>
                )}
                {item.icon === 'map-pin' && (
                  <svg
                    class="w-4 h-4 text-blue-500"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                    />
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                    />
                  </svg>
                )}
                {item.icon === 'phone' && (
                  <svg
                    class="w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 7V5z"
                    />
                  </svg>
                )}
                {item.text}
              </ContentTag>
              {!isLast && <div class="hidden md:block w-px h-4 bg-white/10" />}
            </>
          );
        })
      }
    </div>
  </div>
</section>
